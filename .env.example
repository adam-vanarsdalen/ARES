# Copy to .env and fill in values - never commit .env
ARES_API_KEY=change-me-before-deploy
ARES_ENV=prod
ARES_PROFILE=recon
ARES_ROE_POLICY_PATH=
ARES_ENABLE_ADVANCED_VERIFICATION=false
ARES_REQUIRE_ROE_FOR_ADVANCED=true
ARES_ENABLE_LAB_EXPLOIT_SIMULATION=false
ARES_REQUIRE_LOCAL_TARGET_FOR_LAB_EXPLOIT_SIM=true
ARES_LAB_MANIFEST_PATH=labs/lab_manifest.yaml
ARES_ENABLE_NUCLEI=false
ARES_NUCLEI_PROFILE=safe
ARES_NUCLEI_TEMPLATE_DIR=
ARES_NUCLEI_ALLOWED_TEMPLATE_IDS=
ARES_NUCLEI_ALLOWED_TAGS=exposure,misconfig,headers,tech,panel,ssl
ARES_NUCLEI_MODERATE_TAGS=cve,exposure,misconfig,token-spray-disabled
ARES_NUCLEI_BLOCKED_TAGS=rce,dos,intrusive,bruteforce,credential,file-write,fuzz
ARES_NUCLEI_MAX_TEMPLATES=50
ARES_NUCLEI_TIMEOUT_S=60
ARES_NUCLEI_REQUIRE_ROE_FOR_MODERATE=true
ARES_NUCLEI_REQUIRE_ALLOWLIST_FOR_CUSTOM=true
ARES_ENABLE_EXTERNAL_PLUGINS=false
ARES_ENABLE_OTEL=false
ARES_OTEL_EXPORTER_OTLP_ENDPOINT=
ARES_OLLAMA_MODEL=qwen3.5:9b
ARES_ALLOWED_ORIGINS=http://localhost:8001
ARES_DB_PATH=ares.db
ARES_SESSION_TTL_SECONDS=3600
ARES_HTTP_PROBE_TOTAL_BUDGET_S=15.0
ARES_MISCONFIG_TOTAL_BUDGET_S=20.0
ARES_EXTERNAL_LOOKUP_TIMEOUT_S=8.0
ARES_PASSIVE_HTTP_ALLOWED=false
ARES_ENABLE_NMAP=true
ARES_ENABLE_REVERSE_IP=false
ARES_REVERSE_IP_MAX_HOSTS=50
ARES_PASSIVE_URL_TIMEOUT_S=8.0
ARES_SITEMAP_MAX_CHILDREN=5
ARES_PASSIVE_URL_MAX=100
ARES_SUBDOMAIN_WORDLIST_PATH=wordlists/subdomains-500.txt
ARES_SUBDOMAIN_WORDLIST_MAX=500
ARES_VERSION_DISCLOSURE_TIMEOUT_S=8.0
ARES_EVIDENCE_PREVIEW_MAX_CHARS=500
ARES_RECON_ADDITIONAL_TARGET_MAX=20
ARES_ASSET_INVENTORY_MAX_HTTP_PROBES=20
ARES_TLS_TIMEOUT_S=8.0
ARES_TLS_ADDITIONAL_TARGET_MAX=5
ARES_ENABLE_RISKY_METHOD_CHECKS=false
ARES_API_ENUM_MAX_PATHS=12
ARES_REDTEAM_MAX_VERIFICATIONS=20
ARES_ATTACK_GRAPH_MAX_ROUTE_NODES=50
ARES_ATTACK_GRAPH_MAX_FORM_NODES=30
ARES_ATTACK_GRAPH_MAX_API_NODES=50
ARES_NVD_API_KEY=
ARES_NVD_MIN_DELAY_S=6.5
ARES_CVE_CACHE_TTL_S=86400
ARES_ENABLE_VULNERS=false
ARES_VULNERS_API_KEY=
ARES_ENABLE_MANUAL_SECRET_VERIFY=false
ARES_SECRET_VERIFY_REQUIRE_ADVANCED_PROFILE=true
ARES_SECRET_VERIFY_ALLOWED_PROVIDERS=github,aws,stripe,generic
ARES_MAX_CONCURRENT_SESSIONS=5
ARES_MAX_SESSIONS_PER_MINUTE=10
ARES_EVENT_QUEUE_SIZE=1000
# Comma-separated hosts that bypass scope check - for demo/CI ONLY
# Never add internal hosts here in production
ARES_SAFE_TARGETS=testphp.vulnweb.com,demo.testfire.net,zero.webappsecurity.com
